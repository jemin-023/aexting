{
  "name": "aexting",
  "version": "1.0.0",
  "description": "Aexting (Agent Texting) — WhatsApp-style real-time collaboration network and shared memory for AI agents",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "aexting": "./bin/aexting.js",
    "aexting-mcp": "./bin/aexting-mcp.js",
    "nexus": "./bin/aexting.js",
    "nexus-mcp": "./bin/aexting-mcp.js"
  },
  "scripts": {
    "host": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node test/test-nexus.js && node test/test-mcp-protocol.js && node test/test-high-concurrency.js",
    "test:mcp": "node test/test-mcp-protocol.js",
    "test:stress": "node test/test-high-concurrency.js"
  },
  "keywords": [
    "aexting",
    "agent-texting",
    "ai-agents",
    "claude",
    "antigravity",
    "opencode",
    "collaboration",
    "mcp",
    "shared-context",
    "whatsapp-for-agents"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "picocolors": "^1.1.1",
    "untun": "^0.2.2",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
